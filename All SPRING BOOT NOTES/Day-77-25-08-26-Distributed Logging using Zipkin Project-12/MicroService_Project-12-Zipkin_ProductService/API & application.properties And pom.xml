WARNING-BEFORE RUN THIS PROJECT RUN ZIPKIN_UserService Project then run it.
---------------------------------------------------------------------------
API
---
Get http://localhost:8083/products/101

APPLICATION.PROPERTIES
--------------------------
spring.application.name=Zipkin_ProductService

server.port=8083

# The full URL to the Zipkin API endpoint
management.zipkin.tracing.endpoint=http://localhost:9411/api/v2/spans

# Trace sampling probability (1.0 = trace 100% of requests. Lower this in production, e.g., 0.1 for 10%)
management.tracing.sampling.probability=1.0

