<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       https://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Hibernate SessionFactory -->
    <bean id="sessionFactory"
          class="org.springframework.orm.hibernate5.LocalSessionFactoryBean">

        <!-- Entity Classes -->
        <property name="annotatedClasses">
            <list>
                <value>com.sub.nit.entity.Employee</value>
                <value>com.sub.nit.entity.IdentityCard</value>
            </list>
        </property>

        <!-- Hibernate Properties -->
        <property name="hibernateProperties">
            <props>

                <!-- MySQL Database -->
                <prop key="hibernate.connection.driver_class">
                    com.mysql.cj.jdbc.Driver
                </prop>

                <prop key="hibernate.connection.url">
                    jdbc:mysql://localhost:3306/springonetoonedb
                </prop>

                <prop key="hibernate.connection.username">
                    root
                </prop>

                <prop key="hibernate.connection.password">
                    Subham@123
                </prop>

                <!-- Hibernate Dialect -->
                <prop key="hibernate.dialect">
                    org.hibernate.dialect.MySQLDialect
                </prop>

                <!-- Automatically Create/Update Tables -->
                <prop key="hibernate.hbm2ddl.auto">
                    update
                </prop>

                <!-- Show SQL -->
                <prop key="hibernate.show_sql">
                    true
                </prop>

                <prop key="hibernate.format_sql">
                    true
                </prop>

            </props>
        </property>

    </bean>


    <!-- EmployeeDao Bean -->
    <bean id="employeeDao"
          class="com.sub.nit.dao.EmployeeDao">

        <constructor-arg ref="sessionFactory"/>

    </bean>


    <!-- EmployeeService Bean -->
    <bean id="employeeService"
          class="com.sub.nit.service.EmployeeService">

        <constructor-arg ref="employeeDao"/>

    </bean>

</beans>
